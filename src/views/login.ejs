<%- include('partials/head') %>

<style>
    :root {
        --mcd-red: #DA291C;
        --mcd-dark-red: #B71C1C;
        --mcd-yellow: #FFC72C;
        --mcd-dark: #262220;
        --mcd-gray: #6E6864;
        /* Warm Soft UI base for lively Neumorphism */
        --neu-bg: #F3EFEA;
        --neu-shadow-dark: #D5CFC7;
        --neu-shadow-light: #FFFFFF;
    }

    body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: var(--neu-bg);
        color: var(--mcd-dark);
        -webkit-font-smoothing: antialiased;
    }

    .login-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        box-sizing: border-box;
        position: relative;
        overflow: hidden;
    }

    /* Lively ambient brand glow orbs */
    .login-page::before {
        content: '';
        position: absolute;
        top: -120px;
        right: -120px;
        width: 420px;
        height: 420px;
        background: radial-gradient(circle, rgba(255, 199, 44, 0.28) 0%, rgba(255, 199, 44, 0) 70%);
        border-radius: 50%;
        z-index: 0;
        pointer-events: none;
    }

    .login-page::after {
        content: '';
        position: absolute;
        bottom: -120px;
        left: -120px;
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(218, 41, 28, 0.16) 0%, rgba(218, 41, 28, 0) 70%);
        border-radius: 50%;
        z-index: 0;
        pointer-events: none;
    }

    .login-logo {
        text-align: center;
        margin-bottom: 28px;
        z-index: 1;
    }

    /* Extruded Neumorphic Logo Medallion */
    .login-logo img {
        width: 68px;
        height: 68px;
        object-fit: contain;
        display: block;
        margin: 0 auto 14px;
        padding: 16px;
        border-radius: 50%;
        background: var(--neu-bg);
        box-shadow: 
            9px 9px 18px var(--neu-shadow-dark),
            -9px -9px 18px var(--neu-shadow-light);
        animation: gentleFloat 4s ease-in-out infinite;
    }

    @keyframes gentleFloat {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-5px); }
    }

    .login-logo h1 {
        color: var(--mcd-red);
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin: 0;
        text-shadow: 1px 1px 0px var(--neu-shadow-light);
    }

    /* Raised Neumorphic Card */
    .login-card {
        background: var(--neu-bg);
        width: 100%;
        max-width: 420px;
        padding: 40px;
        border-radius: 28px;
        box-shadow: 
            14px 14px 28px var(--neu-shadow-dark),
            -14px -14px 28px var(--neu-shadow-light);
        box-sizing: border-box;
        z-index: 1;
        border: 1px solid rgba(255, 255, 255, 0.45);
    }

    .login-card h2 {
        text-align: left;
        color: var(--mcd-dark);
        margin: 0 0 26px;
        font-size: 22px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Lively golden accent pill beside heading */
    .login-card h2::before {
        content: '';
        display: inline-block;
        width: 6px;
        height: 22px;
        border-radius: 4px;
        background: linear-gradient(180deg, var(--mcd-yellow), var(--mcd-red));
    }

    .form-group {
        margin-bottom: 22px;
    }

    .login-card label {
        display: block;
        margin-bottom: 9px;
        color: var(--mcd-dark);
        font-weight: 600;
        font-size: 14px;
        padding-left: 4px;
    }

    /* Pressed / Inset Neumorphic Inputs */
    .login-card input {
        display: block;
        width: 100%;
        padding: 15px 18px;
        background: var(--neu-bg);
        border: 1.5px solid transparent;
        border-radius: 14px;
        font-size: 15px;
        box-sizing: border-box;
        outline: none;
        transition: all 0.25s ease;
        color: var(--mcd-dark);
        box-shadow: 
            inset 6px 6px 12px var(--neu-shadow-dark),
            inset -6px -6px 12px var(--neu-shadow-light);
    }

    .login-card input::placeholder {
        color: #9C948E;
    }

    .login-card input:focus {
        border-color: rgba(255, 199, 44, 0.75);
        box-shadow: 
            inset 4px 4px 8px var(--neu-shadow-dark),
            inset -4px -4px 8px var(--neu-shadow-light),
            0 0 0 3px rgba(255, 199, 44, 0.25);
    }

    /* Lively Extruded CTA Button */
    .btn-block {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #E83225 0%, var(--mcd-red) 100%);
        color: white;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 0.3px;
        cursor: pointer;
        margin-top: 10px;
        transition: all 0.2s ease;
        box-shadow: 
            6px 6px 14px rgba(183, 28, 28, 0.28),
            -6px -6px 14px var(--neu-shadow-light);
    }

    .btn-block:hover {
        background: linear-gradient(135deg, #F03A2D 0%, var(--mcd-dark-red) 100%);
        transform: translateY(-2px);
        box-shadow: 
            8px 8px 18px rgba(183, 28, 28, 0.35),
            -6px -6px 14px var(--neu-shadow-light);
    }

    /* Tactile push-in press effect */
    .btn-block:active {
        transform: translateY(1px) scale(0.985);
        box-shadow: 
            inset 4px 4px 8px rgba(120, 12, 12, 0.45),
            inset -3px -3px 7px rgba(255, 110, 100, 0.35);
    }

    .register-link {
        text-align: center;
        margin-top: 26px;
        color: var(--mcd-gray);
        font-size: 14px;
        margin-bottom: 0;
    }

    .register-link a {
        color: var(--mcd-red);
        font-weight: 700;
        text-decoration: none;
        margin-left: 6px;
        padding: 6px 12px;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .register-link a:hover {
        background: var(--neu-bg);
        box-shadow: 
            4px 4px 8px var(--neu-shadow-dark),
            -4px -4px 8px var(--neu-shadow-light);
    }

    /* Recessed Neumorphic Error Alert */
    .alert-error {
        background: var(--neu-bg);
        border-left: 4px solid var(--mcd-red);
        color: var(--mcd-dark-red);
        padding: 13px 16px;
        border-radius: 12px;
        margin-bottom: 22px;
        font-size: 14px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 
            inset 4px 4px 8px var(--neu-shadow-dark),
            inset -4px -4px 8px var(--neu-shadow-light);
    }

    /* Brand Accent Footer Bar */
    .bottom-design {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 10px;
        background: linear-gradient(90deg, var(--mcd-red) 0%, var(--mcd-yellow) 50%, var(--mcd-red) 100%);
        z-index: 10;
        box-shadow: 0 -2px 10px rgba(218, 41, 28, 0.15);
    }

    @media (max-width: 480px) {
        .login-card {
            padding: 28px 22px;
            border-radius: 22px;
            box-shadow: 
                8px 8px 18px var(--neu-shadow-dark),
                -8px -8px 18px var(--neu-shadow-light);
        }
        
        .login-page {
            justify-content: center;
            padding: 24px 16px;
        }
    }
</style>

<div class="login-page">

    <!-- McDonald's Logo and Name -->
    <div class="login-logo">
        <img
            src="/mcdonalds_PNG17.png"
            alt="McDonald's Golden Arches Logo"
        >
        <h1>McDonald's POS</h1>
    </div>

    <!-- Login Form -->
    <form method="POST" action="/login" class="login-card">

        <h2>Sign in to continue</h2>

        <% if (typeof flash !== 'undefined' && flash.error) { %>
            <div class="alert-error">
                <span>⚠️</span> <%= flash.error %>
            </div>
        <% } %>

        <div class="form-group">
            <label for="username">Username</label>
            <input
                type="text"
                id="username"
                name="username"
                placeholder="Enter your username"
                autocomplete="username"
                autofocus
                required
            >
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input
                type="password"
                id="password"
                name="password"
                placeholder="Enter your password"
                autocomplete="current-password"
                required
            >
        </div>

        <button type="submit" class="btn-block">
            Sign In
        </button>

        <p class="register-link">
            No account yet?
            <a href="/register">Register</a>
        </p>

    </form>

    <!-- Brand Accent Footer Bar -->
    <div class="bottom-design"></div>

</div>

<%- include('partials/foot') %>