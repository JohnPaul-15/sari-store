<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' · Sari-Sari POS' : 'Sari-Sari POS' %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    :root {
      --sari-accent: #D94E28;
      --sari-accent-dark: #B53A19;
      --sari-warm: #F5A623;
      --sari-success: #2A8C55;
      --sari-ink: #272320;
      --sari-muted: #6E6761;
      --neu-bg: #F4EFE8;
      --neu-dark: #D6CFC4;
      --neu-light: #FFFFFF;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--neu-bg);
      color: var(--sari-ink);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      width: 100%;
      max-width: 1180px;
      margin: 0 auto;
      padding: 28px 20px 48px;
    }

    .card {
      background: var(--neu-bg);
      border-radius: 26px;
      padding: 26px 28px;
      box-shadow:
        12px 12px 24px var(--neu-dark),
        -12px -12px 24px var(--neu-light);
      border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 20px;
      border: none;
      border-radius: 14px;
      font-family: inherit;
      font-size: 14.5px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: linear-gradient(135deg, #E65C35 0%, var(--sari-accent) 100%);
      color: #FFFFFF;
      box-shadow:
        6px 6px 14px rgba(181, 58, 25, 0.28),
        -5px -5px 12px var(--neu-light);
    }

    .btn-primary:hover:not(:disabled) {
      background: linear-gradient(135deg, #F0663E 0%, var(--sari-accent-dark) 100%);
      transform: translateY(-2px);
      box-shadow:
        8px 8px 18px rgba(181, 58, 25, 0.35),
        -5px -5px 12px var(--neu-light);
    }

    .btn-primary:active:not(:disabled) {
      transform: translateY(1px) scale(0.985);
      box-shadow:
        inset 4px 4px 8px rgba(115, 28, 7, 0.45),
        inset -3px -3px 7px rgba(255, 145, 110, 0.35);
    }

    .btn-secondary {
      background: var(--neu-bg);
      color: var(--sari-ink);
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow:
        6px 6px 12px var(--neu-dark),
        -6px -6px 12px var(--neu-light);
    }

    .btn-secondary:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow:
        8px 8px 16px var(--neu-dark),
        -8px -8px 16px var(--neu-light);
    }

    .btn-secondary:active:not(:disabled) {
      transform: translateY(1px) scale(0.985);
      box-shadow:
        inset 4px 4px 8px var(--neu-dark),
        inset -4px -4px 8px var(--neu-light);
    }

    .btn-block {
      width: 100%;
    }

    .alert {
      padding: 12px 16px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 600;
      background: var(--neu-bg);
      box-shadow:
        inset 4px 4px 8px var(--neu-dark),
        inset -4px -4px 8px var(--neu-light);
    }

    .alert-error {
      color: var(--sari-accent-dark);
      border-left: 4px solid var(--sari-accent);
    }

    .muted {
      color: var(--sari-muted);
    }

    @media print {
      body {
        background: #FFFFFF;
      }

      .card {
        box-shadow: none;
        border: 1px solid #E5E5E5;
      }
    }
  </style>
</head>
<body>