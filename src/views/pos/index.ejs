<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<style>
  :root {
    --pos-accent: #D94E28;
    --pos-accent-dark: #B53A19;
    --pos-warm: #F5A623;
    --pos-success: #2A8C55;
    --pos-ink: #272320;
    --pos-muted: #6E6761;
    --neu-bg: #F4EFE8;
    --neu-dark: #D6CFC4;
    --neu-light: #FFFFFF;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    background: var(--neu-bg);
    color: var(--pos-ink);
    -webkit-font-smoothing: antialiased;
  }

  main.container.pos-layout {
    max-width: 1280px;
    margin: 0 auto;
    padding: 28px 20px 48px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(320px, 1fr);
    gap: 28px;
    align-items: start;
  }

  /* Left Panel: Products */
  .pos-products {
    background: var(--neu-bg);
    border-radius: 28px;
    padding: 28px;
    box-sizing: border-box;
    box-shadow:
      14px 14px 28px var(--neu-dark),
      -14px -14px 28px var(--neu-light);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .pos-products h1 {
    margin: 0 0 20px;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.4px;
    color: var(--pos-accent);
    text-shadow: 1px 1px 0 var(--neu-light);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pos-products h1::before {
    content: '';
    width: 7px;
    height: 24px;
    border-radius: 4px;
    background: linear-gradient(180deg, var(--pos-warm), var(--pos-accent));
    display: inline-block;
  }

  /* Inset Neumorphic Search Bar */
  #productSearch {
    width: 100%;
    padding: 14px 18px;
    margin-bottom: 24px;
    border-radius: 16px;
    border: 1.5px solid transparent;
    background: var(--neu-bg);
    color: var(--pos-ink);
    font-family: inherit;
    font-size: 15px;
    box-sizing: border-box;
    outline: none;
    transition: all 0.22s ease;
    box-shadow:
      inset 6px 6px 12px var(--neu-dark),
      inset -6px -6px 12px var(--neu-light);
  }

  #productSearch::placeholder {
    color: #9A928B;
  }

  #productSearch:focus {
    border-color: rgba(245, 166, 35, 0.8);
    box-shadow:
      inset 4px 4px 8px var(--neu-dark),
      inset -4px -4px 8px var(--neu-light),
      0 0 0 3px rgba(245, 166, 35, 0.22);
  }

  /* Product Tiles Grid */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
    gap: 18px;
  }

  .product-tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    padding: 16px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: var(--neu-bg);
    color: var(--pos-ink);
    text-align: left;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow:
      7px 7px 14px var(--neu-dark),
      -7px -7px 14px var(--neu-light);
  }

  .product-tile:hover {
    transform: translateY(-2px);
    box-shadow:
      9px 9px 18px var(--neu-dark),
      -9px -9px 18px var(--neu-light);
  }

  .product-tile:active {
    transform: translateY(1px) scale(0.985);
    box-shadow:
      inset 4px 4px 9px var(--neu-dark),
      inset -4px -4px 9px var(--neu-light);
  }

  .product-name {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--pos-ink);
  }

  .product-price {
    font-size: 16px;
    font-weight: 800;
    color: var(--pos-accent);
    padding: 4px 10px;
    border-radius: 10px;
    background: var(--neu-bg);
    box-shadow:
      inset 3px 3px 6px var(--neu-dark),
      inset -3px -3px 6px var(--neu-light);
  }

  .product-stock {
    font-size: 12px;
    font-weight: 600;
    color: var(--pos-muted);
  }

  /* Right Panel: Cart & Checkout */
  .pos-cart {
    position: sticky;
    top: 24px;
    background: var(--neu-bg);
    border-radius: 28px;
    padding: 26px;
    box-sizing: border-box;
    box-shadow:
      14px 14px 28px var(--neu-dark),
      -14px -14px 28px var(--neu-light);
    border: 1px solid rgba(255, 255, 255, 0.5);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .pos-cart h2 {
    margin: 0;
    font-size: 21px;
    font-weight: 800;
    color: var(--pos-ink);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pos-cart h2::before {
    content: '';
    width: 6px;
    height: 20px;
    border-radius: 4px;
    background: linear-gradient(180deg, var(--pos-warm), var(--pos-accent));
    display: inline-block;
  }

  /* Recessed Cart Table Container */
  #cartTable {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 8px;
    font-size: 13.5px;
  }

  #cartTable thead th {
    text-align: left;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--pos-muted);
    padding: 0 6px 4px;
  }

  #cartBody td {
    background: var(--neu-bg);
    padding: 10px 8px;
    vertical-align: middle;
    color: var(--pos-ink);
    box-shadow:
      inset 3px 3px 6px var(--neu-dark),
      inset -3px -3px 6px var(--neu-light);
  }

  #cartBody td:first-child {
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
    font-weight: 600;
  }

  #cartBody td:last-child {
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    text-align: right;
  }

  #cartBody button {
    border: none;
    border-radius: 8px;
    padding: 4px 8px;
    font-family: inherit;
    font-weight: 700;
    cursor: pointer;
    background: var(--neu-bg);
    color: var(--pos-accent);
    box-shadow:
      3px 3px 6px var(--neu-dark),
      -3px -3px 6px var(--neu-light);
    transition: all 0.15s ease;
  }

  #cartBody button:active {
    box-shadow:
      inset 2px 2px 4px var(--neu-dark),
      inset -2px -2px 4px var(--neu-light);
  }

  /* Total & Change Readout Pills */
  .cart-total,
  .cart-change {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 13px 16px;
    border-radius: 14px;
    background: var(--neu-bg);
    box-shadow:
      inset 4px 4px 9px var(--neu-dark),
      inset -4px -4px 9px var(--neu-light);
  }

  .cart-total {
    font-size: 17px;
    font-weight: 800;
    color: var(--pos-ink);
  }

  #cartTotal {
    color: var(--pos-accent);
    font-size: 19px;
  }

  .cart-change {
    font-size: 14.5px;
    font-weight: 700;
    color: var(--pos-muted);
  }

  #changeAmount {
    color: var(--pos-success);
    font-weight: 800;
  }

  #checkoutForm {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  #checkoutForm > label {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--pos-ink);
    padding-left: 3px;
  }

  #amountPaid {
    width: 100%;
    padding: 13px 16px;
    border-radius: 14px;
    border: 1.5px solid transparent;
    background: var(--neu-bg);
    color: var(--pos-ink);
    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    box-sizing: border-box;
    outline: none;
    transition: all 0.2s ease;
    box-shadow:
      inset 5px 5px 10px var(--neu-dark),
      inset -5px -5px 10px var(--neu-light);
  }

  #amountPaid:focus {
    border-color: rgba(245, 166, 35, 0.8);
    box-shadow:
      inset 3px 3px 7px var(--neu-dark),
      inset -3px -3px 7px var(--neu-light),
      0 0 0 3px rgba(245, 166, 35, 0.22);
  }

  /* Tactile Checkout CTA */
  #checkoutBtn.btn-block {
    width: 100%;
    padding: 15px 18px;
    margin-top: 4px;
    border: none;
    border-radius: 15px;
    background: linear-gradient(135deg, #E65C35 0%, var(--pos-accent) 100%);
    color: #FFFFFF;
    font-family: inherit;
    font-size: 15.5px;
    font-weight: 800;
    letter-spacing: 0.3px;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow:
      6px 6px 14px rgba(181, 58, 25, 0.28),
      -5px -5px 12px var(--neu-light);
  }

  #checkoutBtn.btn-block:hover:not(:disabled) {
    background: linear-gradient(135deg, #F0663E 0%, var(--pos-accent-dark) 100%);
    transform: translateY(-2px);
    box-shadow:
      8px 8px 18px rgba(181, 58, 25, 0.35),
      -5px -5px 12px var(--neu-light);
  }

  #checkoutBtn.btn-block:active:not(:disabled) {
    transform: translateY(1px) scale(0.985);
    box-shadow:
      inset 4px 4px 8px rgba(115, 28, 7, 0.45),
      inset -3px -3px 7px rgba(255, 145, 110, 0.35);
  }

  #checkoutBtn.btn-block:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    transform: none;
    box-shadow:
      inset 3px 3px 7px var(--neu-dark),
      inset -3px -3px 7px var(--neu-light);
    background: var(--neu-bg);
    color: var(--pos-muted);
  }

  @media (max-width: 900px) {
    main.container.pos-layout {
      grid-template-columns: 1fr;
    }

    .pos-cart {
      position: static;
    }
  }

  @media (max-width: 480px) {
    .pos-products,
    .pos-cart {
      padding: 20px 16px;
      border-radius: 22px;
    }

    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }
</style>

<main class="container pos-layout">
  <div class="pos-products">
    <h1>Point of Sale</h1>
    <input type="search" id="productSearch" placeholder="Search product or scan barcode..." autofocus />
    <div class="product-grid" id="productGrid">
      <% products.forEach(p => { %>
        <button
          type="button"
          class="product-tile"
          data-id="<%= p.id %>"
          data-name="<%= p.name %>"
          data-price="<%= p.selling_price %>"
          data-stock="<%= p.stock_quantity %>"
          data-unit="<%= p.unit %>"
        >
          <span class="product-name"><%= p.name %></span>
          <span class="product-price"><%= peso(p.selling_price) %></span>
          <span class="product-stock"><%= p.stock_quantity %> <%= p.unit %> left</span>
        </button>
      <% }) %>
    </div>
  </div>

  <div class="pos-cart">
    <h2>Cart</h2>
    <table class="table" id="cartTable">
      <thead><tr><th>Item</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr></thead>
      <tbody id="cartBody"></tbody>
    </table>
    <div class="cart-total">Total: <span id="cartTotal">₱0.00</span></div>

    <form method="POST" action="/pos/checkout" id="checkoutForm">
      <input type="hidden" name="items" id="itemsInput" />
      <label>Amount Paid
        <input type="number" step="0.01" min="0" name="amount_paid" id="amountPaid" required />
      </label>
      <div class="cart-change">Change: <span id="changeAmount">₱0.00</span></div>
      <button type="submit" class="btn btn-primary btn-block" id="checkoutBtn" disabled>Complete Sale</button>
    </form>
  </div>
</main>
<script src="/js/pos.js"></script>
<%- include('../partials/foot') %>